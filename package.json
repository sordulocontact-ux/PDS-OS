{
  "name": "pds-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.80",
    "@ai-sdk/groq": "^4.0.48",
    "@ai-sdk/mistral": "^4.0.50",
    "@ai-sdk/react": "4.0.117",
    "@base-ui/react": "^1.8.0",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "ai": "^7.0.114",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "modern-screenshot": "4.7.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "nucleo-sharp-essential": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.12",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.5.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": "prettier --write"
  }
}
