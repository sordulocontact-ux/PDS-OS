# dependencies
/node_modules
/.pnp
.pnp.*
# pnpm only — lockfiles from other package managers are accidental
package-lock.json
yarn.lock

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# testing
/coverage
/playwright-report/
/test-results/

# env — only the example is committed
.env*
!.env.example

# supabase local stack
supabase/.temp/
supabase/.branches/

# vercel
.vercel

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# os / editors
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# Local database export (emails, password hashes): never commit
pds-data.sql

# Local database backups (emails, password hashes): never commit
backups/
