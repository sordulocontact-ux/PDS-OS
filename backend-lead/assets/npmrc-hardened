# .npmrc durci — défense supply chain (npm ≥ 11.15). Copie à la racine du projet.
# Contexte 2026 : axios (mars), Mini Shai-Hulud (mai), ChainDrop (août) — le vecteur est presque
# toujours un script d'installation exécuté dans les minutes suivant la publication.

# Quarantaine : refuse toute version publiée il y a moins de 7 jours (fallback sur la précédente).
min-release-age=7

# Bloque les scripts pre/post-install (RCE au `npm install`). Liste blanche ci-dessous.
ignore-scripts=true

# Bloque les sources hors registre (git:, file:, http:, dossiers locaux).
allow-git=false
allow-file=none
allow-remote=none
allow-directory=none

# Vérifie signatures/provenance quand disponibles.
audit=true
fund=false

# Installation reproductible : en CI utilise `npm ci` (jamais `npm install`).
package-lock=true
save-exact=true

# --- Paquets autorisés à exécuter des scripts d'install (à adapter, garde la liste courte) ---
# Exécute-les explicitement après l'install : `npm rebuild sharp esbuild prisma`
# ou via un script "postinstall" du projet qui appelle uniquement ceux-ci.
# Exemples fréquents : sharp, esbuild, prisma, @prisma/client, bcrypt, argon2, better-sqlite3

# --- Équivalents ---
# pnpm ≥ 10.16 (pnpm-workspace.yaml) :
#   minimumReleaseAge: 10080        # 7 jours (v11 met 1440 = 1 jour par défaut)
#   minimumReleaseAgeExclude: []    # exceptions ponctuelles (patch de sécurité urgent)
#   strictDepBuilds: true           # v11 : par défaut
#   onlyBuiltDependencies: [sharp, esbuild, prisma]
# Yarn 4.10+ (.yarnrc.yml) : npmMinimalAgeGate: 7d
# Bun 1.3+ (bunfig.toml) : [install] minimumReleaseAge = 604800
# Python : `uv sync --locked` en CI, `pip-audit`, pas de `pip install` sans lock.
#
# CI : actions GitHub épinglées par SHA, pas de secrets pour les PR de forks,
#      `dependency-review-action`, `npm audit signatures`.
