# Copy to .env.local and fill in. Never commit .env.local.
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle:
# never put a secret behind that prefix.

# ── Supabase ──────────────────────────────────────────────────────────────
# Printed by `supabase start` (API URL, anon key, service_role key).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by the daily cron job alone, never in a
# path triggered by a user. Required in production for release detection.
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM (structured extraction) ───────────────────────────────────────────
# mistral (default) | google (fallback) | anthropic (production choice)
LLM_PROVIDER=mistral
# Optional. Defaults: ministral-14b-latest | gemini-flash-latest | claude-haiku-5-5
# mistral-medium-latest is better but has a zero quota on the free tier.
LLM_MODEL=
# Required when LLM_PROVIDER=mistral — https://console.mistral.ai
MISTRAL_API_KEY=
# Required when LLM_PROVIDER=google — https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
# Required when LLM_PROVIDER=anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Transcription ─────────────────────────────────────────────────────────
# groq (default)
TRANSCRIPTION_PROVIDER=groq
# Optional. Default: whisper-large-v3-turbo (whisper-large-v3 is slower, more accurate)
TRANSCRIPTION_MODEL=
# Required when TRANSCRIPTION_PROVIDER=groq — https://console.groq.com
GROQ_API_KEY=

# ── Release detection ─────────────────────────────────────────────────────
# Deezer, iTunes and MusicBrainz need no key. Odesli closed its public API
# (401 without key): request a key through its whitelist form. Optional.
ODESLI_API_KEY=

# YouTube Data API v3: reads the public views, likes and comments of a YouTube
# link for « Relever les statistiques » of an activation. Optional: without it
# PDS OS uses po@'s Google token (GOOGLE_CALENDAR_*) when it was granted
# youtube.readonly; with neither, YouTube links are noted by hand. A key goes
# restricted to this API. TikTok videos and Deezer playlists need no key.
YOUTUBE_API_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────
# Secret sent by Vercel Cron as "Authorization: Bearer <CRON_SECRET>".
# At least 32 characters: openssl rand -hex 32
CRON_SECRET=

# Free tiers may use requests for training: no real client data here.
# See docs/CONTEXTE-PROJET.md § 8.

# ── Web Push (browser notifications) ──────────────────────────────────────
# Optional: without them the bell still works, only system notifications are off.
# Generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key reaches the browser (not a secret); the private key never does.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact given to push services: mailto:… or https://…
VAPID_SUBJECT=
# Proves to the database that a push claim comes from this server, not from a
# browser. At least 32 characters (openssl rand -hex 32), and the same value in
# the Vault secret "push_claim_secret" (docs/ARCHITECTURE.md § 8 bis). The
# local value is set by supabase/seed.sql.
PUSH_CLAIM_SECRET=

# ── Unsplash and Tumblr (similar references of the Conception) ────────────
# « Chercher des références semblables »: PO reads the moodboard and its
# searches run on each source whose key is set. Both free and optional.
# Unsplash: https://unsplash.com/oauth/applications → New Application → the
# « Access Key ». Demo mode: 50 calls an hour; « Apply for production » for
# more (photos shown from Unsplash's addresses, photographer credited, each
# kept photo reported: already done by the app).
UNSPLASH_ACCESS_KEY=
# Tumblr: https://www.tumblr.com/oauth/apps → Register application → the
# « OAuth Consumer Key ». 1,000 calls an hour, 5,000 a day.
TUMBLR_API_KEY=

# ── Are.na (similar references of the Conception) ─────────────────────────
# Switched off for now (ARENA_ENABLED in lib/design/similar-sources.ts).
# Optional: without it, Are.na is explored « by rebound » (free): the channels
# of the Are.na images already kept, or of a pasted Are.na link. With it, PO's
# searches also run on Are.na by words: its search (/v3/search) is for Premium
# accounts only. https://www.are.na/settings → Personal access tokens → a
# read-only token of a Premium account.
ARENA_TOKEN=

# ── Figma (an artist's moodboards, Identité tab) ───────────────────────────
# Optional: without it, « Importer depuis Figma » is not offered. A personal
# access token: Figma → Settings → Security → Personal access tokens, scope
# « File content: read-only ». It reads the files its account can open: share
# the moodboard files with that account. Never sent to the browser.
FIGMA_TOKEN=

# ── Openverse (similar references of the Conception) ───────────────────────
# Switched off for now (OPENVERSE_ENABLED in lib/design/similar-sources.ts).
# Searched without any key; without these, it allows 200 searches a day per
# server address (shared on Vercel).
# Free application: POST https://api.openverse.org/v1/auth_tokens/register/
# with a name, a description and an e-mail, confirm the e-mail, then copy the
# client id and secret. docs/ARCHITECTURE.md (Conception, Références).
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# ── Notion (feedback sent by the director) ────────────────────────────────
# Optional: without them, sent feedback stays in the app (tab "Transmis").
# 1. https://www.notion.so/my-integrations → New integration (internal) → copy
#    the secret. 2. Open the Notion database, "…" → Connections → add it.
# 3. The database id is the 32 characters of its link, before "?v=".
# Properties expected: docs/ARCHITECTURE.md § 8 quater.
NOTION_TOKEN=
NOTION_FEEDBACK_DATABASE_ID=
# Optional: PO's unanswered questions (no text, no person), one row each
# (docs/ASSISTANT.md § 4 bis). Same integration, connected to that database.
NOTION_PO_GAPS_DATABASE_ID=

# ── Google Calendar (Meet link of a new call) ────────────────────────────
# Optional: without them, a new call takes a video link pasted by hand.
# With them, PDS OS creates the event in this Google account's calendar, with
# a Meet link, and Google e-mails the invitation to every participant.
# 1. console.cloud.google.com → a project → enable "Google Calendar API"
#    "Google Drive API" and "Google Meet REST API" (the same token uploads files
#    to Drive and turns on Meet's automatic transcription of each call).
# 2. OAuth consent screen (Internal, or External + this account as test user),
#    then Credentials → OAuth client ID → "Desktop app": client id and secret.
# 3. node scripts/google-calendar-token.mjs <client id> <client secret>
#    signs in once with the organizer's account and prints the refresh token
#    (scopes calendar.events, drive.file, meetings.space.settings and
#    meetings.space.readonly). External consent screen: publish
#    the app, or Google drops the token after 7 days.
# docs/ARCHITECTURE.md § 4 bis.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Optional: another calendar of the account than its main one ("primary").
GOOGLE_CALENDAR_ID=

# Google Workspace (Paramètres › Connexions): each member's Agenda, Gmail and
# Drive read with no click, through a service account the domain delegated.
# 1. Google Cloud, project « PDS OS »: enable the Calendar, Gmail and Drive
#    APIs; IAM → Service accounts → create one, then Keys → JSON.
# 2. admin.google.com → Security → Access and data control → API controls →
#    Domain-wide delegation: add the account's client id with exactly
#    https://www.googleapis.com/auth/calendar.readonly,
#    https://www.googleapis.com/auth/gmail.readonly,
#    https://www.googleapis.com/auth/drive.readonly
# 3. The JSON key below (as is, or `base64 -i key.json`), server-only. It reads
#    every mailbox of the domain: PDS OS only ever asks for the signed-in
#    member's own address. docs/ARCHITECTURE.md § 4 quater.
GOOGLE_WORKSPACE_KEY=
GOOGLE_WORKSPACE_DOMAIN=pdsrecords.com

# « Connecter un compte Google » (Paramètres › Connexions): a member adds any
# other Google account (Gmail perso…), read-only. Google Cloud, project
# « PDS OS »: Credentials → OAuth client ID → « Web application », redirect
# URI <NEXT_PUBLIC_SITE_URL>/api/google/callback (one per site: local,
# pré-prod, prod). OAuth consent screen « External », published (« In
# production »): until Google verifies the app, a member passes the screen
# « Google n'a pas validé cette application » once (100 accounts at most).
# GOOGLE_TOKEN_KEY seals the refresh tokens: `openssl rand -base64 32`.
# Without the three, the button is not shown. docs/ARCHITECTURE.md § 4 quater.
GOOGLE_CONNECT_CLIENT_ID=
GOOGLE_CONNECT_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=

# Juridique: seals the private links (fiches) so they stay visible in their
# démarche. 32 bytes in base64 (`openssl rand -base64 32`). Server-only.
# Optional: without it, a link is shown once, then only its state.
LEGAL_LINK_KEY=

# E-mails sent by PDS OS itself (lib/email/send.ts), from PO's Google account
# through Gmail's SMTP. Server-only. The account needs 2-step verification;
# create an app password at myaccount.google.com → Security → App passwords.
# Optional: without them, each sending is declared (« Marquer comme envoyé »).
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# The same pair reads PO's mailbox through IMAP (lib/email/inbox.ts): the
# replies to the authorisation requests, filed by /api/cron/inbox. IMAP must be
# on in Gmail's settings of the account. One app password for sending and
# reading: a new one goes here, on Vercel and in Supabase's SMTP settings
# (Authentication → Emails), which sends the sign-up and reset e-mails.
# The cron is called by pg_cron every 10 min: Vault secrets inbox_poll_url
# (https://<site>/api/cron/inbox) and cron_secret (= CRON_SECRET).

# ── Pre-production only (branch `pre-prod`, docs/PREPROD.md) ──────────────
# « 1 » shows the bar « Voir comme / Aller à » and PO's test data. The test
# accounts of supabase/preprod/seed.sql share PREPROD_PASSWORD (4+ chars).
# Set them on the `pre-prod` branch of Vercel only, never in Production.
PREPROD_TOOLS=
PREPROD_PASSWORD=

# ── Performance ───────────────────────────────────────────────────────────
# « 1 » logs, after each page render (server logs, Vercel « Logs »), its
# database requests: count, time end to end, chain depth, the slowest
# (lib/supabase/query-trace.ts, docs/ARCHITECTURE.md § 3 bis). Off by default.
PERF_TRACE=
